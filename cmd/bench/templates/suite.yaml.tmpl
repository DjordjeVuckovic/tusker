schema_version: 1
id: {{.Name}}_v1
version: "0.1.0"
description: "TODO: describe what this suite tests"

corpus:
  name: news_hunter_articles
  source: "postgres://localhost:54320/news_db (articles)"
  # snapshot_at: 2026-05-21T00:00:00Z   # optional — set when corpus is frozen

templates:
  - id: pg_fts_multi_field
    args: [terms, limit]
    query: |
      SELECT id FROM articles
      WHERE to_tsvector('english', title || ' ' || coalesce(description,'') || ' ' || coalesce(content,''))
            @@ plainto_tsquery('english', $1)
      ORDER BY ts_rank(
        to_tsvector('english', title || ' ' || coalesce(description,'') || ' ' || coalesce(content,'')),
        plainto_tsquery('english', $1)
      ) DESC
      LIMIT $2::int

  # An elasticsearch search template is Mustache over the Query DSL: quote string
  # params, and render the query_vector arg with toJson.
  # - id: es_multi_match
  #   args: [terms]
  #   query: |
  #     {"query": {"multi_match": {"query": "{{`{{terms}}`}}", "fields": ["title^3", "description^2", "content"]}}, "size": 100}

queries:
  - id: example-q1
    description: "Replace with a real search intent — e.g. 'climate change effects on biodiversity'"
    engines:
      pg:
        template: pg_fts_multi_field
        params: { terms: "climate change", limit: 100 }
      # elasticsearch:
      #   template: es_multi_match
      #   params: { terms: "climate change" }
