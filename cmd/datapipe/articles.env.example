DATASET_PATH=/path/to/dataset.csv
MAPPING_CONFIG_PATH=/path/to/mapping.yaml
# Set MAPPING_ENABLED=false to ingest an already-canonical dataset (datapipe preprocess).
# MAPPING_ENABLED=true

# Bulk upsert config
BULK_ENABLED=true
BULK_SIZE=5000

# optional embedding config
# EMBEDDING_SOURCE=online
# EMBEDDING_ENABLED=true
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=qwen3-embedding:0.6b
