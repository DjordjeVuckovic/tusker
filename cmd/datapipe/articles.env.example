DATASET_PATH=/path/to/canonical-dataset.jsonl
# Set MAPPING_ENABLED=true (with MAPPING_CONFIG_PATH) to map a raw dataset
# inline instead of loading the preprocess output.
# MAPPING_ENABLED=true
# MAPPING_CONFIG_PATH=/path/to/mapping.yaml

# Bulk upsert config
BULK_ENABLED=true
BULK_SIZE=5000

# optional embedding config
# EMBEDDING_SOURCE=online
# EMBEDDING_ENABLED=true
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=qwen3-embedding:0.6b
