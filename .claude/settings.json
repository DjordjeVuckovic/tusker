{
  "permissions": {
    "allow": [
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go fmt:*)",
      "Bash(go mod tidy)",
      "Bash(go vet :*)"
    ]
  },
  "env": {
  },
  "PostToolUse": [
    {
      "matcher": "Write(*.go)",
      "hooks": [
        {
          "type": "command",
          "command": "go "
        }
      ]
    }
  ]
}