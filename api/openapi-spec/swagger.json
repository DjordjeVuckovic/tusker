{
    "swagger": "2.0",
    "info": {
        "description": "A full-text and semantic search engine for exploring multilingual news headlines and articles",
        "title": "Tusker API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "email": "support@tusker.sh"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "https://opensource.org/licenses/Apache-2.0"
        },
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/v1/articles/_search": {
            "post": {
                "description": "Structured match, multi_match, phrase, boolean or hybrid search. A stated operator, field, fuzziness or language is honoured by the engine or the request is a 400 naming the parameter and the engine. An omitted operator takes the engine's default (PostgreSQL AND, Elasticsearch OR). Boosts are best effort. A key the query type does not define is a 400. With `Prefer: handling=lenient` an unsupported parameter is removed before the search runs and listed in `ignored`. Every response echoes `effective` and `ignored`.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "search"
                ],
                "summary": "Structured search API",
                "parameters": [
                    {
                        "description": "Structured search request with query wrapper",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_DjordjeVuckovic_tusker_internal_api_dto.SearchRequest"
                        }
                    },
                    {
                        "type": "string",
                        "description": "handling=lenient drops a parameter the engine cannot honour and lists it in ignored, instead of a 400",
                        "name": "Prefer",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "SearchStringQuery results with pagination metadata",
                        "schema": {
                            "$ref": "#/definitions/github_com_DjordjeVuckovic_tusker_internal_api_dto.SearchResponse"
                        }
                    },
                    "400": {
                        "description": "Bad request - invalid query structure or parameters",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "501": {
                        "description": "Query type not supported by searcher backend",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/articles/search": {
            "get": {
                "description": "Free-text search over title, description and content: operators and quotes are read as words. Terms combine under the engine's default operator (PostgreSQL AND, Elasticsearch OR); the response echoes it in `effective`. Any query parameter not listed here is a 400. Cacheable and bookmarkable.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "search"
                ],
                "summary": "Simple query string search",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"climate change\"",
                        "description": "SearchStringQuery query text",
                        "name": "q",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "example": 10,
                        "description": "Results per page (default: 100, max: 10000)",
                        "name": "size",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Pagination cursor (base64-encoded from previous response)",
                        "name": "cursor",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "\"english\"",
                        "description": "SearchStringQuery language: english, the only one supported (default: english)",
                        "name": "lang",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "handling=lenient drops a parameter the engine cannot honour and lists it in ignored, instead of a 400",
                        "name": "Prefer",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "SearchStringQuery results with pagination metadata",
                        "schema": {
                            "$ref": "#/definitions/github_com_DjordjeVuckovic_tusker_internal_api_dto.SearchResponse"
                        }
                    },
                    "400": {
                        "description": "Bad request - missing or invalid parameters",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/articles/semantic_search": {
            "get": {
                "description": "Perform vector-based semantic search using the embedding model. Supports pagination via cursor. Application determines optimal search strategy based on index configuration. Results are cacheable and bookmarkable.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "search"
                ],
                "summary": "Vector-based semantic search",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"climate change\"",
                        "description": "SearchStringQuery query text",
                        "name": "q",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "example": 10,
                        "description": "Results per page (default: 100, max: 10000)",
                        "name": "size",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Pagination cursor (base64-encoded from previous response)",
                        "name": "cursor",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "SearchStringQuery results with pagination metadata",
                        "schema": {
                            "$ref": "#/definitions/github_com_DjordjeVuckovic_tusker_internal_api_dto.SemanticSearchResponse"
                        }
                    },
                    "400": {
                        "description": "Bad request - missing or invalid parameters",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/capabilities": {
            "get": {
                "description": "Returns the query types the running backend serves and the full-text parameters its engine honours: the operator it applies when a request names none, whether it supports fuzziness, phrase slop and boosts, and the fields it can match apart from every other field. A stated parameter outside these is a 400 unless the request sends `Prefer: handling=lenient`.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "capabilities"
                ],
                "summary": "Report supported query types and parameters",
                "responses": {
                    "200": {
                        "description": "Supported query types and parameters",
                        "schema": {
                            "$ref": "#/definitions/github_com_DjordjeVuckovic_tusker_internal_api_dto.CapabilitiesResponse"
                        }
                    }
                }
            }
        }
    },
