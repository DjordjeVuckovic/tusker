# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/

**/testdata

# Dataset payloads (raw, canonical, embeddings); fetched or generated, never committed
datasets/**/*.csv
datasets/**/*.json
datasets/**/*.jsonl
datasets/**/*.parquet
datasets/**/*.npz
datasets/**/*.gz
datasets/*/raw/**
datasets/*/canonical/**
datasets/*/embeddings/**

# Kaggle kernel config is per corpus and is committed, unlike the payloads above.
!datasets/**/kernel-metadata.json

# Package descriptors and load records are provenance and are committed. The
# directory rules let git descend to them, since a file under an ignored
# directory cannot be re-included.
!datasets/*/raw/**/
!datasets/*/canonical/**/
!datasets/*/embeddings/**/
!datasets/**/datapackage.json
!datasets/*/loads/*/*.json

__pycache__/
.ruff_cache/

# Regenerable bench exports (bench export --format html|markdown); the .json
# reports next to them are provenance and stay tracked.
tracks/**/reports/*.html
tracks/**/reports/*.md

bin/**
benchmark_results/

*.env
.local

.docs/

.thesis

.bugs/

CLAUDE.local.md

.notes

tracks/**/trec/qrels.*.tsv

.issues